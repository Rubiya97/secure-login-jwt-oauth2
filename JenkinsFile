pipeline {
    agent any

    environment {
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-21.0.10'
        MAVEN_HOME = tool name: 'Maven Auto', type: 'maven'
        PATH = "${MAVEN_HOME}/bin;${env.PATH}"
    }

    stages {
        stage('Build Backend') {
            steps {
                dir('oauth2') {
                    echo "Building backend..."
                    // Inject credentials here
                    withCredentials([
                        string(credentialsId: 'DB_USERNAME', variable: 'DB_USERNAME'),
                        string(credentialsId: 'DB_PASSWORD', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'GOOGLE_CLIENT_ID', variable: 'GOOGLE_CLIENT_ID'),
                        string(credentialsId: 'GOOGLE_CLIENT_SECRET', variable: 'GOOGLE_CLIENT_SECRET')
                    ]) {
                        // Run Maven package with environment variables
                        bat 'mvn clean package -Dspring.datasource.username=%DB_USERNAME% -Dspring.datasource.password=%DB_PASSWORD% -Dspring.security.oauth2.client.registration.google.client-id=%GOOGLE_CLIENT_ID% -Dspring.security.oauth2.client.registration.google.client-secret=%GOOGLE_CLIENT_SECRET%'
                    }
                }
            }
        }

        stage('Test Backend') {
            steps {
                dir('oauth2') {
                    echo "Running backend tests..."
                    withCredentials([
                        string(credentialsId: 'DB_USERNAME', variable: 'DB_USERNAME'),
                        string(credentialsId: 'DB_PASSWORD', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'GOOGLE_CLIENT_ID', variable: 'GOOGLE_CLIENT_ID'),
                        string(credentialsId: 'GOOGLE_CLIENT_SECRET', variable: 'GOOGLE_CLIENT_SECRET')
                    ]) {
                        bat 'mvn test -Dspring.datasource.username=%DB_USERNAME% -Dspring.datasource.password=%DB_PASSWORD% -Dspring.security.oauth2.client.registration.google.client-id=%GOOGLE_CLIENT_ID% -Dspring.security.oauth2.client.registration.google.client-secret=%GOOGLE_CLIENT_SECRET%'
                    }
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend-oauth') {
                    echo "Building frontend..."
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Deployment step goes here (optional)"
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed. Check logs for details."
        }
    }
}
